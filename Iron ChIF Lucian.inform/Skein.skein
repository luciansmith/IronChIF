    <command xml:space="preserve">x post</command>
    <result xml:space="preserve">Two posts for displaying cloaks.&#x000A;&#x000A;&gt;</result>
    <commentary xml:space="preserve">Two posts for displaying cloaks.&#x000A;&#x000A;&gt;</commentary>
