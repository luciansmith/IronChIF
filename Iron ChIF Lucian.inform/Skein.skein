    <children>
      <child nodeId="node-81"/>
    </children>
  </item>
  <item nodeId="node-81">
    <command xml:space="preserve">summon mist</command>
    <result xml:space="preserve">(the grey mist)&#x000A;You sing, drawing the moisture from the room into a wisp of fog, but it twists into nothingness again as the echoes of your song fade.&#x000A;&#x000A;&gt;</result>
    <commentary xml:space="preserve">(the grey mist)&#x000A;You sing, drawing the moisture from the room into a wisp of fog, but it twists into nothingness again as the echoes of your song fade.&#x000A;&#x000A;&gt;</commentary>
    <changed>NO</changed>
    <children>
      <child nodeId="node-82"/>
    </children>
  </item>
  <item nodeId="node-82">
    <command xml:space="preserve">u</command>
    <result xml:space="preserve">Upper Great Hall&#x000A;There is a small platform just inside the huge double doors of the Great Hall, and that's it.  The platform is lined with a single elegant grown-mahogany branch that wraps around the whole platform.  It varies in size and thickness, so that all types of feet fit somewhere along it, so people can comfortably launch themselves into the air to glide down to the floor level, or grab it for stability as they return.&#x000A;&#x000A;&gt;</result>
    <commentary xml:space="preserve">Upper Great Hall&#x000A;There is a small platform just inside the huge double doors of the Great Hall, and that's it.  The platform is lined with a single elegant grown-mahogany branch that wraps around the whole platform.  It varies in size and thickness, so that all types of feet fit somewhere along it, so people can comfortably launch themselves into the air to glide down to the floor level, or grab it for stability as they return.&#x000A;&#x000A;&gt;</commentary>
    <changed>NO</changed>
    <children>
      <child nodeId="node-83"/>
    </children>
  </item>
  <item nodeId="node-83">
    <command xml:space="preserve">summon mist</command>
    <result xml:space="preserve">(the grey mist)&#x000A;You sing, drawing the moisture from the room into a wisp of fog, but it twists into nothingness again as the echoes of your song fade.&#x000A;&#x000A;&gt;</result>
    <commentary xml:space="preserve">(the grey mist)&#x000A;You sing, drawing the moisture from the room into a wisp of fog, but it twists into nothingness again as the echoes of your song fade.&#x000A;&#x000A;&gt;</commentary>
