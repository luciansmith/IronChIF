  <item nodeId="node-259">
    <command xml:space="preserve">i</command>
    <result xml:space="preserve">You are carrying:&#x000A;  an invisible hunting cloak (being worn)&#x000A;  a black capsa (open)&#x000A;    a scroll of igram&#x000A;  a leather rucksack (open)&#x000A;    a blue capsa of mist (closed)&#x000A;    a red capsa of hasten (open)&#x000A;      a scroll of quiste&#x000A;    a purple capsa of opening (open)&#x000A;      a scroll of rezrov&#x000A;    a gold capsa of down (closed)&#x000A;&#x000A;&gt;</result>
